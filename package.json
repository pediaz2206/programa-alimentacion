{
  "name": "en-punto",
  "private": true,
  "version": "0.1.0",
  "description": "En Punto: convierte el plan de la nutricionista en recordatorios accionables, en el momento justo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/check-node.mjs && node --experimental-strip-types --test packages/core/test/*.test.ts",
    "hoy": "node scripts/check-node.mjs && node --experimental-strip-types packages/core/src/cli.ts",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test",
    "vista": "node scripts/check-node.mjs && node --experimental-strip-types scripts/build-vista.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
